#!/usr/bin/env bash
# Compile Tailwind once into static/css/tw.css (the browser no longer builds CSS on every page).
# Needs the standalone Tailwind v3 CLI: https://github.com/tailwindlabs/tailwindcss/releases/tag/v3.4.17
set -euo pipefail
cd "$(dirname "$0")/.."
TW="${TAILWIND:-$(command -v tailwindcss || echo ./bin/tailwindcss)}"
"$TW" -c tailwind.config.js -i assets/tw.in.css -o static/css/tw.css --minify
